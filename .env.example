# PostgreSQL connection string
DATABASE_URL=postgres://mizan:mizan@localhost:5432/mizan

# JWT signing secret - generate with: openssl rand -base64 48
JWT_SECRET=change-me-in-production

# Session lifetime in hours
SESSION_HOURS=72

# Server port
PORT=3000

# Set to "production" when deployed
NODE_ENV=development


# OpenRouter - one key for many models (GPT, Llama, Qwen, Gemma, Jais...)
# Get it from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic (Claude) API key
ANTHROPIC_API_KEY=
