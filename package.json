{
  "name": "mizan-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mizan - National LLM Evaluation Framework for Iraqi Arabic. Public platform: leaderboard, model registry, benchmark explorer.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "import:items": "tsx tools/import-items.ts",
    "import:results": "tsx tools/import-results.ts",
    "create:admin": "tsx tools/create-admin.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "tsx runner/run.ts",
    "import:items2": "tsx tools/import-items.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "list:models": "tsx tools/list-models.ts",
    "batch": "tsx tools/run-batch.ts",
    "debug:model": "tsx tools/debug-model.ts"
  },
